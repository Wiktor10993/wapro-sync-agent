# ---------------------------------------------------------------------------
# Zmienne dla środowiska DEWELOPERSKIEGO
#
#   cp dev.env.example dev.env
#   source dev.env          ← w KAŻDYM nowym oknie Terminala
#
# Ścieżki są względne wobec katalogu, w którym wywołujesz `source`,
# więc rób to zawsze z katalogu cloud_hub/.
# ---------------------------------------------------------------------------

export HUB_ENV=development
export HUB_DEBUG=1

export HUB_DB_PATH="$PWD/storage/hub.sqlite"
export HUB_LOG_PATH="$PWD/storage/hub.log"
export HUB_LOG_LEVEL=debug

# Do testów lokalnych wystarczy stała wartość. Na produkcji: openssl rand -hex 32
export HUB_API_KEY_PEPPER="dev-pepper-tylko-do-testow-nie-na-produkcje"

# Pusty sekret = webhook BaseLinkera przyjmuje żądania bez weryfikacji podpisu.
# W testach lokalnych to wygodne, na produkcji ustaw własny.
export HUB_BL_WEBHOOK_SECRET=""

# --- Allegro ---------------------------------------------------------------
# Puste = testy bez prawdziwego konta. seed_demo.php podstawi zamówienia sam.
export ALLEGRO_CLIENT_ID=""
export ALLEGRO_CLIENT_SECRET=""
export ALLEGRO_REDIRECT_URI="http://localhost:8000/oauth/allegro/callback"

# Środowisko testowe Allegro (sandbox) — odkomentuj, gdy masz konto testowe:
# export ALLEGRO_API_BASE="https://api.allegro.pl.allegrosandbox.pl"
# export ALLEGRO_AUTH_BASE="https://allegro.pl.allegrosandbox.pl/auth/oauth"

# --- BaseLinker ------------------------------------------------------------
export BASELINKER_TOKEN=""
export BASELINKER_INVENTORY_ID=""
export BASELINKER_WAREHOUSE_ID="bl_1"

# --- pozostałe -------------------------------------------------------------
export HUB_ECHO_WINDOW=180
export HUB_TENANT_ID="dev"

# ---------------------------------------------------------------------------
# Cloud Hub — zmienne środowiskowe
#
# Wczytaj je w konfiguracji serwera (SetEnv w Apache, fastcgi_param w nginx,
# Environment= w systemd) albo wyeksportuj przed uruchomieniem skryptów CLI.
# Ten plik jest wzorcem — NIE trzymaj w nim prawdziwych sekretów w repozytorium.
# ---------------------------------------------------------------------------

# --- aplikacja -------------------------------------------------------------
HUB_ENV=production
HUB_DEBUG=0
HUB_MAX_BATCH=1000

# --- baza ------------------------------------------------------------------
# MUSI leżeć poza katalogiem public/
HUB_DB_PATH=/var/lib/wapro-hub/hub.sqlite

# --- bezpieczeństwo --------------------------------------------------------
# Pieprz do HMAC kluczy API agentów. Wygeneruj: openssl rand -hex 32
# Zmiana tej wartości unieważnia WSZYSTKIE istniejące klucze agentów.
HUB_API_KEY_PEPPER=

# Sekret HMAC do weryfikacji podpisu webhooka BaseLinkera (nagłówek X-BL-Signature).
# Pusty = webhook przyjmuje żądania bez weryfikacji podpisu (odradzane).
HUB_BL_WEBHOOK_SECRET=

# --- Allegro ---------------------------------------------------------------
# Z panelu Allegro → Moje aplikacje. Typ aplikacji: "z dostępem do przeglądarki".
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=

# Adres powrotny OAuth. Musi zgadzać się CO DO ZNAKU z konfiguracją w Allegro.
# Gdy pusty, hub złoży go z bieżącego hosta: https://<host>/oauth/allegro/callback
ALLEGRO_REDIRECT_URI=https://hub.twojafirma.pl/oauth/allegro/callback

# Środowisko testowe Allegro (sandbox) — odkomentuj do testów:
# ALLEGRO_API_BASE=https://api.allegro.pl.allegrosandbox.pl
# ALLEGRO_AUTH_BASE=https://allegro.pl.allegrosandbox.pl/auth/oauth

# --- BaseLinker ------------------------------------------------------------
# Wartości globalne; można je nadpisać per klient w panelu (Ustawienia).
BASELINKER_TOKEN=
BASELINKER_INVENTORY_ID=
BASELINKER_WAREHOUSE_ID=bl_1

# --- Anti-Loop -------------------------------------------------------------
# Okno (sekundy), w którym przychodzące zdarzenie o tej samej wartości
# co nasz wcześniejszy push jest traktowane jako echo.
HUB_ECHO_WINDOW=180

# --- logi ------------------------------------------------------------------
HUB_LOG_PATH=/var/log/wapro-hub/hub.log
HUB_LOG_LEVEL=info

# --- CLI -------------------------------------------------------------------
# Domyślny tenant dla skryptów w bin/ (można też podać jako pierwszy argument).
HUB_TENANT_ID=

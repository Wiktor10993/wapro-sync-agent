{
  "name": "wapro-sync-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Lokalny agent synchronizacji Wapro Mag ⇄ Allegro / BaseLinker (stany i zamówienia).",
  "author": {
    "name": "Integracja Wapro",
    "email": "kontakt@twojafirma.pl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wiktor10993/wapro-sync-agent.git"
  },
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && electron-builder",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:win": "electron-vite build && electron-builder --win",
    "build:dir": "electron-vite build && electron-builder --dir"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "mssql": "9.3.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.0",
    "electron-vite": "^2.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "build": {
    "appId": "pl.integracja.waproagent",
    "productName": "Wapro Sync Agent",
    "copyright": "Copyright © 2026 Integracja Wapro",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "WaproSyncAgent-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wapro Sync Agent",
      "artifactName": "WaproSyncAgent-Setup-${version}.${ext}"
    }
  }
}
